{
  "$comment": "Test-only grammar registry. vscode-tmgrammar-snap resolves include: targets through contributes.grammars, and drops any pattern whose include target is unregistered - which would silently hide every Slim filter region from the snapshots.",
  "contributes": {
    "grammars": [
      {
        "language": "slim",
        "scopeName": "text.slim",
        "path": "../slim.tmLanguage.json"
      },
      {
        "scopeName": "source.coffee",
        "path": "./stubs/source-coffee.tmLanguage.json"
      },
      {
        "scopeName": "source.css",
        "path": "./stubs/source-css.tmLanguage.json"
      },
      {
        "scopeName": "source.css.less",
        "path": "./stubs/source-css-less.tmLanguage.json"
      },
      {
        "scopeName": "source.css.scss",
        "path": "./stubs/source-css-scss.tmLanguage.json"
      },
      {
        "scopeName": "source.js",
        "path": "./stubs/source-js.tmLanguage.json"
      },
      {
        "scopeName": "source.ruby",
        "path": "./stubs/source-ruby.tmLanguage.json"
      },
      {
        "scopeName": "source.sass",
        "path": "./stubs/source-sass.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml",
        "path": "./stubs/source-yaml.tmLanguage.json"
      },
      {
        "scopeName": "text.html.basic",
        "path": "./stubs/text-html-basic.tmLanguage.json"
      },
      {
        "scopeName": "text.html.erb",
        "path": "./stubs/text-html-erb.tmLanguage.json"
      },
      {
        "scopeName": "text.html.markdown",
        "path": "./stubs/text-html-markdown.tmLanguage.json"
      },
      {
        "path": "../slim-interpolation.injection.json",
        "scopeName": "slim.interpolation.injection",
        "injectTo": [
          "text.slim"
        ]
      }
    ]
  }
}
