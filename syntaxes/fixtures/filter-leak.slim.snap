>/ Every filter below leaves a construct of its embedded grammar open. The line after it must be a
#^ text.slim comment.block.slim comment.line.slash.slim
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ text.slim comment.block.slim
>/ Slim tag again, and a filter nested under a tag must hand back to its sibling.
#^ text.slim comment.block.slim comment.line.slash.slim
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ text.slim comment.block.slim
>javascript:
#^^^^^^^^^^ text.slim source.js.filter.slim constant.language.name.javascript.filter.slim
#          ^ text.slim source.js.filter.slim
>  const a = LEFT_OPEN_BY_THE_STUB
#^^^^^^^^^^^^ text.slim source.js.filter.slim
#            ^^^^^^^^^^^^^^^^^^^^^ text.slim source.js.filter.slim meta.left-open.stub
>p after javascript
#^ text.slim meta.tag entity.name.tag.slim
# ^^^^^^^^^^^^^^^^^^ text.slim
>coffee:
#^^^^^^ text.slim text.coffeescript.filter.slim constant.language.name.coffeescript.filter.slim
