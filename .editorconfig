root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_size = 2
indent_style = space
max_line_length = 150
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Grammar fixtures are input, not source: `multiline-ruby.slim` holds lines whose trailing space is
# the whole point of the case, and a `.snap` quotes its fixture line for line. Trimming either turns
# the test green without testing anything, which `manifest.test.ts` also guards against.
[syntaxes/fixtures/*.{slim,snap}]
trim_trailing_whitespace = false
